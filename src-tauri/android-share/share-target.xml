        <!-- 分享到 Minipad(0.5.5 文字,0.5.6 起还有图片和文件):别的 App 分享时列出 Minipad,交给 MainActivity。
             外观设置里文字、图片、文件三个开关的每一种组合对应下面一个入口,MainActivity 只开对应的那一个
             (同时开几个时,同一种内容的分享列表里会出现几个 Minipad);三个都关时全停用。
             没打开过 Minipad 时用 .ShareAll(三个开关默认都开)。
             文字:text/plain。图片:image/*。文件:其他类型;不收文字时只列常见的文字类文件,收文字时是 text/* -->
        <activity-alias
            android:name=".ShareTarget"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".ShareImages"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".ShareFiles"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="font/*" />
                <data android:mimeType="model/*" />
                <data android:mimeType="message/*" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="text/x-markdown" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/comma-separated-values" />
                <data android:mimeType="text/tab-separated-values" />
                <data android:mimeType="text/html" />
                <data android:mimeType="text/xml" />
                <data android:mimeType="text/rtf" />
                <data android:mimeType="text/calendar" />
                <data android:mimeType="text/x-vcalendar" />
                <data android:mimeType="text/vcard" />
                <data android:mimeType="text/x-vcard" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".ShareTextImages"
