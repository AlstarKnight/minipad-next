{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Minipad Next",
  "version": "0.1.0",
  "identifier": "com.minipadnext.app",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "npm run prepare-assets",
    "beforeBuildCommand": "npm run prepare-assets"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Minipad Next",
        "width": 440,
        "height": 540,
        "minWidth": 260,
        "minHeight": 180,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true,
        "dragDropEnabled": false,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https: http:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese"
        ]
      }
    }
  }
}
