{
  "name": "minipad-next",
  "version": "0.4.4",
  "private": true,
  "description": "热键呼出的悬浮多标签笔记本,参考 minipad2 的使用体验",
  "scripts": {
    "prepare-assets": "node scripts/prepare.mjs",
    "preview": "node scripts/prepare.mjs && node scripts/serve.mjs",
    "test:ui": "node scripts/prepare.mjs && node --test tests/ui.test.mjs",
    "icons": "tauri icon app-icon.svg -o src-tauri/icons",
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "android:init": "tauri android init",
    "android:build": "tauri android build --apk --target aarch64",
    "prepare-mobile": "node scripts/prepare-mobile.mjs",
    "test:mobile": "npm run prepare-mobile && node --test tests/mobile.test.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "esbuild": "^0.28.2",
    "playwright": "1.64.0"
  },
  "dependencies": {
    "@highlightjs/cdn-assets": "^11.12.0",
    "@milkdown/kit": "^7.22.3"
  }
}
